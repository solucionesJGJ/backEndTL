    { "key": "statusPendingId", "value": "", "type": "string" },
    { "key": "statusReceivedId", "value": "", "type": "string" },
    { "key": "statusProcessId", "value": "", "type": "string" },
    { "key": "statusReprocessId", "value": "", "type": "string" },
