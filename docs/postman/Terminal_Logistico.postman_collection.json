              "mode": "raw",
              "raw": "{\n  \"plate\": \"ABCD{{$timestamp}}\",\n  \"brand\": \"Mercedes-Benz\",\n  \"model\": \"Sprinter Actualizado\",\n  \"year\": 2025,\n  \"active\": true\n}"
            },
            "url": "{{baseUrl}}/vehicles/{{vehicleId}}"
          }
        },
        {
          "name": "Deactivate Vehicle",
          "request": { "method": "PATCH", "url": "{{baseUrl}}/vehicles/{{vehicleId}}/deactivate" }
        }
      ]
    },
    {
      "name": "Jornadas Transportista",
      "item": [
        {
          "name": "Get Driver Checklist",
          "request": { "method": "GET", "url": "{{baseUrl}}/driver-shifts/checklist" }
        },
        {
          "name": "Get Current Driver Shift",
          "request": { "method": "GET", "url": "{{baseUrl}}/driver-shifts/current" }
        },
        {
          "name": "Get Driver Shift History",
          "request": { "method": "GET", "url": "{{baseUrl}}/driver-shifts/history" }
        },
        {
          "name": "Start Driver Shift",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vehicle_id\": \"{{vehicleId}}\",\n  \"initial_mileage\": {{initialMileage}},\n  \"observations\": \"Inicio desde Postman\",\n  \"checklist\": [\n    { \"code\": \"TIRES\", \"checked\": true, \"observations\": null },\n    { \"code\": \"LIGHTS\", \"checked\": true, \"observations\": null },\n    { \"code\": \"BRAKES\", \"checked\": true, \"observations\": null },\n    { \"code\": \"LEVELS\", \"checked\": true, \"observations\": null },\n    { \"code\": \"VEHICLE_DOCUMENTS\", \"checked\": true, \"observations\": null },\n    { \"code\": \"CLEANING\", \"checked\": true, \"observations\": null },\n    { \"code\": \"VISIBLE_DAMAGE\", \"checked\": true, \"observations\": null },\n    { \"code\": \"LICENSE\", \"checked\": true, \"observations\": null },\n    { \"code\": \"FITNESS\", \"checked\": true, \"observations\": null },\n    { \"code\": \"SAFETY_EQUIPMENT\", \"checked\": true, \"observations\": null },\n    { \"code\": \"DRIVER_DOCUMENTS\", \"checked\": true, \"observations\": null }\n  ]\n}"
            },
            "url": "{{baseUrl}}/driver-shifts/start",
            "description": "Si el checklist real cambia, ejecutar primero 'Get Driver Checklist' y ajustar los codes requeridos."
          }
        },
        {
          "name": "Finish Driver Shift",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"final_mileage\": {{finalMileage}},\n  \"observations\": \"Fin de jornada desde Postman\"\n}"
            },
            "url": "{{baseUrl}}/driver-shifts/finish"
          }
        }
      ]
    }
  ]
}
