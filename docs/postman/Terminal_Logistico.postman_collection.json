    {
      "name": "Auth",
      "item": [
        {
          "name": "Bootstrap Admin",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Administrador\",\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/bootstrap-admin",
            "description": "Usar solo en una BD sin usuarios. Si ya existe cualquier usuario, respondera 409."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.token) pm.collectionVariables.set('token', json.token);",
                  "if (json.user?.id) pm.collectionVariables.set('userId', json.user.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('login ok', () => pm.expect(json.ok).to.eql(true));",
                  "if (json.token) pm.collectionVariables.set('token', json.token);",
                  "if (json.user?.id) pm.collectionVariables.set('userId', json.user.id);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Catalogos Base",
      "item": [
        {
          "name": "List Roles",
          "request": { "method": "GET", "url": "{{baseUrl}}/roles" },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (Array.isArray(json.data)) {",
                  "  const byName = Object.fromEntries(json.data.map(r => [r.name, r.id]));",
                  "  if (byName.admin) pm.collectionVariables.set('adminRoleId', byName.admin);",
                  "  if (byName.client_operator) pm.collectionVariables.set('clientOperatorRoleId', byName.client_operator);",
                  "  if (byName.warehouse_operator) pm.collectionVariables.set('warehouseOperatorRoleId', byName.warehouse_operator);",
                  "  if (byName.transportista) pm.collectionVariables.set('transportistaRoleId', byName.transportista);",
                  "  if (byName.admin) pm.collectionVariables.set('roleId', byName.admin);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "List Movement Statuses",
          "request": { "method": "GET", "url": "{{baseUrl}}/movement-statuses" },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (Array.isArray(json.data)) {",
                  "  const byCode = Object.fromEntries(json.data.map(s => [s.code, s.id]));",
                  "  const vars = {",
                  "    BORRADOR_CLIENTE: 'statusDraftId',",
                  "    PENDIENTE_RECEPCION: 'statusPendingId',",
                  "    RECEPCIONADO: 'statusReceivedId',",
                  "    EN_PROCESO: 'statusProcessId',",
                  "    REPROCESO: 'statusReprocessId',",
                  "    PREPARADO_DESPACHO: 'statusPreparedId',",
                  "    EN_TRASLADO: 'statusTransferId',",
                  "    RETORNADO_CLIENTE: 'statusReturnedId',",
                  "    CERRADO: 'statusClosedId'",
                  "  };",
                  "  Object.entries(vars).forEach(([code, key]) => { if (byCode[code]) pm.collectionVariables.set(key, byCode[code]); });",
                  "  if (byCode.PENDIENTE_RECEPCION) pm.collectionVariables.set('fromStatusId', byCode.PENDIENTE_RECEPCION);",
                  "  if (byCode.RECEPCIONADO) pm.collectionVariables.set('toStatusId', byCode.RECEPCIONADO);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
