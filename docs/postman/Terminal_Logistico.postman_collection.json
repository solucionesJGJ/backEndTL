{
  "info": {
    "_postman_id": "c0fce5aa-3a55-4f67-8e02-terminal-logistico",
    "name": "Terminal Logistico API",
    "description": "Collection dinamica para probar todos los endpoints montados bajo /api. Ejecuta primero Auth/Login o Bootstrap Admin y luego las consultas base para cargar variables como roleId, clientId, garmentId, batchId y status IDs.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('response is JSON when body exists', function () {",
          "  if (pm.response.text()) {",
          "    pm.response.to.have.header('Content-Type');",
          "  }",
          "});"
        ]
      }
    }
  ],
